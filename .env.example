# CRZ Telegram bot token
TELEGRAM_BOT_TOKEN=

# Usually official API; use a local Telegram Bot API on THIS server only if you install one.
TELEGRAM_API_ROOT=https://api.telegram.org

# Public CRZ web app URL on this server
WEBAPP_URL=https://crz.example.com

# Google OAuth - can use the same Google Cloud project/client if this redirect URI is authorized
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crz.example.com/auth/google/callback

# 64 hex characters / 32 bytes
TOKEN_ENCRYPTION_KEY=

PORT=3000
MAX_CONCURRENT_UPLOADS=2

# CRZ processing
MIRROR_AUDIO_TARGET=aac
TORRENT_PREFLIGHT_SECONDS=12

# Resolver Python environment created by install script
PYTHON_BIN=/home/ubuntu/Project_XTRM/CRZ_Bot/resolver/.venv/bin/python
